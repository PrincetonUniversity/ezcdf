# ---------------------------------------------------------------------------
# EZCDF Makefile
#
# PPPL Flux
# Intel oneAPI 2023.2.0
# OpenMPI 4.1.6
#
# Required environment/modules:
#
#   module load intel/2023.2.0
#   module load openmpi/4.1.6-intel-2023.2.0-f6nrfjk
#
#   module load openmpi-4.1.6/intel-2023.2.0/hdf5/1.14.6-c77my
#   module load openmpi-4.1.6/intel-2023.2.0/netcdf-c/4.9.2-qpqoj
#   module load openmpi-4.1.6/intel-2023.2.0/netcdf-fortran/4.6.1-bfskx
#
# The NetCDF modules define:
#
#   NETCDF_C_HOME
#   NETCDF_F_HOME
#
# Usage:
#
#   source env_intel_2023_ezcdf.sh
#   make show
#   make
#   make install
#
# ---------------------------------------------------------------------------

SHELL := /bin/bash


# ---------------------------------------------------------------------------
# Compilers
#
# Use compilers supplied by the environment.
# Fall back to Intel compilers when not explicitly configured.
# ---------------------------------------------------------------------------

ifeq ($(origin FC),default)
    FC = ifort
endif

ifeq ($(origin FC),undefined)
    FC = ifort
endif

ifeq ($(origin CC),default)
    CC = icx
endif

ifeq ($(origin CC),undefined)
    CC = icx
endif

ifeq ($(origin CXX),default)
    CXX = icpx
endif

ifeq ($(origin CXX),undefined)
    CXX = icpx
endif

F90 ?= $(FC)


# ---------------------------------------------------------------------------
# Build configuration
# ---------------------------------------------------------------------------

DEBUG ?= 0


# ---------------------------------------------------------------------------
# NetCDF configuration
#
# On Flux:
#
#   libnetcdff.so -> $(NETCDF_F_HOME)/lib
#   libnetcdf.so  -> $(NETCDF_C_HOME)/lib64
#
# Do not rely on nf-config --flibs alone because it may not provide
# the NetCDF C library search directory.
# ---------------------------------------------------------------------------

NETCDF_FORTRAN_HOME ?= $(NETCDF_F_HOME)

NETCDF_MODDIR ?= $(NETCDF_F_HOME)/include

NETCDF_F_LIBDIR := $(NETCDF_F_HOME)/lib
NETCDF_C_LIBDIR := $(NETCDF_C_HOME)/lib64

FINCL := \
    -I$(NETCDF_MODDIR) \
    -I$(NETCDF_C_HOME)/include


# ---------------------------------------------------------------------------
# NetCDF libraries
#
# L_NETCDF may be supplied by the environment.
# Otherwise construct it from the NetCDF installation paths.
# ---------------------------------------------------------------------------

L_NETCDF ?= \
    -L$(NETCDF_F_LIBDIR) \
    -lnetcdff \
    -L$(NETCDF_C_LIBDIR) \
    -lnetcdf \
    -lm


# ---------------------------------------------------------------------------
# NetCDF runtime search paths
# ---------------------------------------------------------------------------

NETCDF_RPATH := \
    -Wl,-rpath,$(NETCDF_F_LIBDIR) \
    -Wl,-rpath,$(NETCDF_C_LIBDIR)


# ---------------------------------------------------------------------------
# Fortran compiler flags
#
# Intel ifort 2023.2.0
#
# -O2           Optimization
# -xCORE-AVX2   Generate AVX2 instructions for supported Intel CPUs
# -fPIC         Position-independent code for shared libraries
# -traceback    Runtime traceback information
#
# -c is intentionally NOT included in FFLAGS.
# The object compilation rule explicitly supplies -c.
# ---------------------------------------------------------------------------

FFLAGS_OPT ?= \
    -g \
    -O2 \
    -xCORE-AVX2 \
    -fPIC \
    -traceback

FFLAGS_DBG ?= \
    -g \
    -O0 \
    -fPIC \
    -traceback \
    -warn all \
    -check all \
    -fpe0


# ---------------------------------------------------------------------------
# Select Fortran flags
#
# Use FFLAGS supplied by the environment when DEBUG=0.
# For DEBUG=1, use the debug flags.
# ---------------------------------------------------------------------------

ifeq ($(DEBUG),0)
    FFLAGS ?= $(FFLAGS_OPT)
else
    FFLAGS := $(FFLAGS_DBG)
endif


# ---------------------------------------------------------------------------
# C compiler flags
# ---------------------------------------------------------------------------

CFLAGS_OPT ?= \
    -g \
    -O2 \
    -xCORE-AVX2 \
    -fPIC

CFLAGS_DBG ?= \
    -g \
    -O0 \
    -fPIC \
    -Wall


ifeq ($(DEBUG),0)
    CFLAGS ?= $(CFLAGS_OPT)
else
    CFLAGS := $(CFLAGS_DBG)
endif


# ---------------------------------------------------------------------------
# C++ compiler flags
# ---------------------------------------------------------------------------

CXXFLAGS_OPT ?= \
    -g \
    -O2 \
    -xCORE-AVX2 \
    -fPIC

CXXFLAGS_DBG ?= \
    -g \
    -O0 \
    -fPIC \
    -Wall


ifeq ($(DEBUG),0)
    CXXFLAGS ?= $(CXXFLAGS_OPT)
else
    CXXFLAGS := $(CXXFLAGS_DBG)
endif


# ---------------------------------------------------------------------------
# General linker flags
#
# May be supplied by the environment.
# ---------------------------------------------------------------------------

LDFLAGS ?=


# ---------------------------------------------------------------------------
# Intel Fortran runtime
#
# FLIBROOT is defined by the Intel environment.
#
# Linking with ifort automatically includes the Intel Fortran runtime.
# The C++ executable needs the Intel Fortran runtime explicitly.
# ---------------------------------------------------------------------------

L_FLIBS ?= \
    -Wl,-rpath,$(FLIBROOT) \
    -L$(FLIBROOT) \
    -lifcore \
    -lifport \
    -limf \
    -lsvml \
    -lintlc \
    -lm


# ---------------------------------------------------------------------------
# Intel C++ / Fortran runtime
#
# L_CLIBS may be supplied by the environment.
#
# The Intel Fortran runtime is needed when the C++ test executable
# links against Fortran EZCDF.
# ---------------------------------------------------------------------------

L_CLIBS ?= \
    -Wl,-rpath,$(FLIBROOT) \
    -L$(FLIBROOT) \
    -lifcore \
    -lifport \
    -limf \
    -lsvml \
    -lintlc \
    -lstdc++ \
    -lm


# ---------------------------------------------------------------------------
# Installation directories
#
# PREFIX may be supplied by the environment.
# ---------------------------------------------------------------------------

SRCDIR := $(CURDIR)

PREFIX ?= $(SRCDIR)/builds

LIBDIR := $(PREFIX)/lib
INCDIR := $(PREFIX)/include
MODDIR := $(PREFIX)/mod
BINDIR := $(PREFIX)/bin


# ---------------------------------------------------------------------------
# Library and executable names
# ---------------------------------------------------------------------------

LIBAR := libezcdf.a
LIBSO := libezcdf.so

EXEF90 := eztest
EXECXX := eztest2


# ---------------------------------------------------------------------------
# Sources and objects
# ---------------------------------------------------------------------------

SRCS := \
    ezcdf_inqvar.f90 \
    ezcdf_opncls.f90 \
    ezcdf_attrib.f90 \
    ezcdf_genget.f90 \
    ezcdf_genput.f90 \
    ezcdf.f90 \
    handle_err.f90

OBJS := $(SRCS:.f90=.o)


# ---------------------------------------------------------------------------
# Main targets
# ---------------------------------------------------------------------------

.PHONY: all clean clobber install uninstall show

all: $(LIBAR) $(LIBSO) $(EXEF90) $(EXECXX)


# ---------------------------------------------------------------------------
# Static library
# ---------------------------------------------------------------------------

$(LIBAR): $(OBJS)
	@echo "Building EZCDF static library"
	@rm -f $@
	ar rcs $@ $(OBJS)


# ---------------------------------------------------------------------------
# Shared library
#
# NetCDF Fortran and NetCDF C are direct dependencies of libezcdf.so.
#
# Runtime paths are embedded so that libezcdf.so can locate the
# NetCDF libraries used during the build.
# ---------------------------------------------------------------------------

$(LIBSO): $(OBJS)
	@echo "Building EZCDF shared library"
	@rm -f $@
	$(FC) -shared $(LDFLAGS) \
		-o $@ \
		$(OBJS) \
		$(L_NETCDF) \
		$(NETCDF_RPATH)


# ---------------------------------------------------------------------------
# Fortran test executable
# ---------------------------------------------------------------------------

$(EXEF90): $(LIBSO) $(EXEF90).f90
	@echo "Building $(EXEF90)"
	$(FC) $(FFLAGS) \
		$(EXEF90).f90 \
		-o $@ \
		-L$(SRCDIR) \
		-lezcdf \
		-Wl,-rpath,$(SRCDIR) \
		$(L_NETCDF) \
		$(L_FLIBS)


# ---------------------------------------------------------------------------
# C++ test executable
# ---------------------------------------------------------------------------

$(EXECXX): $(LIBSO) $(EXECXX).cc
	@echo "Building $(EXECXX)"
	$(CXX) $(CXXFLAGS) \
		$(EXECXX).cc \
		-o $@ \
		$(FINCL) \
		-L$(SRCDIR) \
		-lezcdf \
		-Wl,-rpath,$(SRCDIR) \
		$(L_NETCDF) \
		$(L_CLIBS)


# ---------------------------------------------------------------------------
# Fortran object compilation
#
# Explicit -c is required.
# It is intentionally not included in FFLAGS.
# ---------------------------------------------------------------------------

%.o: %.f90
	$(FC) $(FFLAGS) -c $< -o $@ $(FINCL)


# ---------------------------------------------------------------------------
# Show build configuration
# ---------------------------------------------------------------------------

show:
	@echo
	@echo "============================================================"
	@echo " EZCDF build configuration -- Flux / Intel 2023"
	@echo "============================================================"
	@echo
	@echo "Compilers:"
	@echo "  FC              = $(FC)"
	@echo "  CC              = $(CC)"
	@echo "  CXX             = $(CXX)"
	@echo
	@echo "Build:"
	@echo "  DEBUG           = $(DEBUG)"
	@echo "  PREFIX          = $(PREFIX)"
	@echo
	@echo "NetCDF:"
	@echo "  NETCDF_F_HOME   = $(NETCDF_F_HOME)"
	@echo "  NETCDF_C_HOME   = $(NETCDF_C_HOME)"
	@echo "  NETCDF_MODDIR   = $(NETCDF_MODDIR)"
	@echo
	@echo "Compiler flags:"
	@echo "  FFLAGS          = $(FFLAGS)"
	@echo "  CFLAGS          = $(CFLAGS)"
	@echo "  CXXFLAGS        = $(CXXFLAGS)"
	@echo
	@echo "Libraries:"
	@echo "  L_NETCDF        = $(L_NETCDF)"
	@echo "  L_FLIBS         = $(L_FLIBS)"
	@echo "  L_CLIBS         = $(L_CLIBS)"
	@echo
	@echo "============================================================"


# ---------------------------------------------------------------------------
# Install
# ---------------------------------------------------------------------------

install: all
	@echo "Installing EZCDF in $(PREFIX)"

	@mkdir -p $(LIBDIR)
	@mkdir -p $(INCDIR)
	@mkdir -p $(MODDIR)
	@mkdir -p $(BINDIR)

	@cp ezcdf.hh $(INCDIR)
	@cp *.mod $(MODDIR)

	@if [ -d ref ]; then \
		rm -rf $(PREFIX)/ref; \
		cp -r ref $(PREFIX); \
	fi

	@cp $(LIBAR) $(LIBDIR)
	@cp $(LIBSO) $(LIBDIR)
	@cp $(EXEF90) $(BINDIR)
	@cp $(EXECXX) $(BINDIR)


# ---------------------------------------------------------------------------
# Uninstall
# ---------------------------------------------------------------------------

uninstall:
	@rm -rf $(PREFIX)


# ---------------------------------------------------------------------------
# Clean
# ---------------------------------------------------------------------------

clean:
	@rm -f *~
	@rm -f $(OBJS)
	@rm -f *.mod


# ---------------------------------------------------------------------------
# Complete cleanup
# ---------------------------------------------------------------------------

clobber: clean
	@rm -f $(LIBAR)
	@rm -f $(LIBSO)
	@rm -f $(EXEF90)
	@rm -f $(EXECXX)