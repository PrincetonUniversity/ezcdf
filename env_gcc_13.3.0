#!/bin/bash
#
# ============================================================================
# EZCDF environment
#
# PPPL Ranger
# GCC Toolset 13 / GCC 13.3.0
# OpenMPI system RPM
# HDF5 / NetCDF system RPM libraries
#
# TRANSP shared branch
# MAKE_SO=1
#
# Start a shell with:
#
#     scl enable gcc-toolset-13 bash
#
# Then:
#
#     source ./env_gcc_13.3.0
#     make show
#     make clobber
#     make
#     make install
#
# Used with the common, machine-independent EZCDF Makefile.
# ============================================================================


# ============================================================================
# GCC Toolset 13
# ============================================================================

export GCC_ROOT=/opt/rh/gcc-toolset-13/root/usr

if [[ ! -d "${GCC_ROOT}/bin" ]]; then
    echo "ERROR: GCC Toolset 13 is not installed:"
    echo "  ${GCC_ROOT}/bin"
    return 1
fi

export PATH="${GCC_ROOT}/bin:${PATH}"

hash -r

export GCC_RUNTIME_ROOT="${GCC_ROOT}"


# ============================================================================
# Compilers
# ============================================================================

export FC=gfortran
export F90=gfortran
export CC=gcc
export CXX=g++


# ============================================================================
# Compiler validation
#
# Ranger uses GCC Toolset 13.
#
# The expected compiler is GCC 13.3.0.
#
# Accept GCC 13.x releases to avoid unnecessary failure if the system
# GCC Toolset receives a minor-version update.
# ============================================================================

for compiler in gfortran gcc g++; do
    if ! command -v "${compiler}" >/dev/null 2>&1; then
        echo "ERROR: Required compiler not found: ${compiler}"
        return 1
    fi
done

GCC_VERSION="$(gfortran -dumpfullversion -dumpversion)"
GCC_MAJOR="${GCC_VERSION%%.*}"

if [[ "${GCC_MAJOR}" != "13" ]]; then
    echo "ERROR: GCC Toolset 13 is required."
    echo "Detected GCC version: ${GCC_VERSION}"
    return 1
fi

echo "Using GCC ${GCC_VERSION}"


# ============================================================================
# GCC runtime
#
# Determine the actual Fortran runtime location from the active compiler.
#
# Resolve symbolic links so that FLIBROOT points to the directory
# containing the runtime library.
# ============================================================================

LIBGFORTRAN="$(gfortran -print-file-name=libgfortran.so)"

if [[ ! -f "${LIBGFORTRAN}" ]]; then
    echo "ERROR: Cannot locate libgfortran.so"
    echo "Compiler returned: ${LIBGFORTRAN}"
    return 1
fi

export FLIBROOT="$(
    dirname "$(readlink -f "${LIBGFORTRAN}")"
)"


# ============================================================================
# OpenMPI
#
# Ranger uses the system RPM OpenMPI installation.
# ============================================================================

export OPENMPI_HOME=/usr/lib64/openmpi

export PATH="${OPENMPI_HOME}/bin:${PATH}"

export MPIF90="${OPENMPI_HOME}/bin/mpif90"
export MPIFC="${OPENMPI_HOME}/bin/mpifort"
export MPICC="${OPENMPI_HOME}/bin/mpicc"
export MPICXX="${OPENMPI_HOME}/bin/mpicxx"

export FORTRAN_COMMAND="${MPIF90}"
export CC_COMMAND="${MPICC}"
export CX_COMMAND="${MPICXX}"

# EZCDF itself does not require MPI.
# MPI compiler wrappers are retained for compatibility with TRANSP.


# ============================================================================
# HDF5 / NetCDF
#
# Ranger uses system RPM installations under /usr.
# ============================================================================

export HDF5_HOME=/usr

export NETCDF_C_HOME=/usr
export NETCDF_F_HOME=/usr
export NETCDF_FORTRAN_HOME=/usr


# ============================================================================
# NetCDF Fortran modules
#
# Ranger RPM packages install the gfortran module files here.
# ============================================================================

export NETCDF_MODDIR=/usr/lib64/gfortran/modules

if [[ ! -f "${NETCDF_MODDIR}/netcdf.mod" ]]; then
    echo "ERROR: NetCDF Fortran module not found:"
    echo "  ${NETCDF_MODDIR}/netcdf.mod"
    return 1
fi


# ============================================================================
# Build configuration
#
# MAKE_SO=1 enables shared-library builds.
#
# The common EZCDF Makefile also builds libezcdf.a.
# ============================================================================

export MAKE_SO=1


# ============================================================================
# Build/install location
#
# Preserve an externally supplied PREFIX.
#
# Otherwise install under:
#
#     $(EZCDF_SOURCE_ROOT)/builds/gcc/13.3.0
#
# The actual detected GCC version is used in the directory name.
# ============================================================================

export EZCDF_SOURCE_ROOT="$(
    cd "$(dirname "${BASH_SOURCE[0]}")" && pwd
)"

export PREFIX="${PREFIX:-${EZCDF_SOURCE_ROOT}/builds/gcc/${GCC_VERSION}}"


# ============================================================================
# Compiler flags
#
# -fPIC
#     Required for libezcdf.so.
#
# -fallow-argument-mismatch
# -fallow-invalid-boz
# -fno-range-check
# -fdollar-ok
#     Compatibility options for legacy Fortran source.
#
# No Ranger CPU-specific -march option is used.
# ============================================================================

export FFLAGS="\
-g \
-O2 \
-m64 \
-fPIC \
-fallow-argument-mismatch \
-fallow-invalid-boz \
-fno-range-check \
-fdollar-ok"

export CFLAGS="\
-g \
-O2 \
-m64 \
-fPIC"

export CXXFLAGS="\
-g \
-O2 \
-m64 \
-fPIC"


# ============================================================================
# General linker flags
# ============================================================================

export LDFLAGS=""


# ============================================================================
# HDF5 libraries
#
# Ranger system RPM installation.
# ============================================================================

export L_HDF5="\
-Wl,-rpath,${HDF5_HOME}/lib64 \
-L${HDF5_HOME}/lib64 \
-lhdf5_fortran \
-lhdf5hl_fortran \
-lhdf5_hl \
-lhdf5"


# ============================================================================
# NetCDF / HDF5 libraries
#
# Ranger system RPM layout:
#
#     NetCDF Fortran : /usr/lib64
#     NetCDF C       : /usr/lib64
#     HDF5           : /usr/lib64
#
# RPATH is included for consistency with the existing build.
# ============================================================================

export L_NETCDF="\
-Wl,-rpath,${NETCDF_F_HOME}/lib64 \
-L${NETCDF_F_HOME}/lib64 \
-lnetcdff \
-Wl,-rpath,${NETCDF_C_HOME}/lib64 \
-L${NETCDF_C_HOME}/lib64 \
-lnetcdf \
${L_HDF5} \
-lm"


# ============================================================================
# GNU Fortran runtime
# ============================================================================

export L_FLIBS="\
-Wl,-rpath,${FLIBROOT} \
-L${FLIBROOT} \
-lgfortran \
-lm"


# ============================================================================
# GNU C/C++ runtime
# ============================================================================

export L_CLIBS="\
-Wl,-rpath,${FLIBROOT} \
-L${FLIBROOT} \
-lstdc++ \
-lgfortran \
-lgcc_s \
-lgcc"


# ============================================================================
# Runtime shared-library search path
#
# GCC Toolset libraries are placed before system libraries.
# ============================================================================

export LD_LIBRARY_PATH="\
${GCC_ROOT}/lib64:\
${GCC_ROOT}/lib:\
${FLIBROOT}:\
${OPENMPI_HOME}/lib:\
${HDF5_HOME}/lib64:\
${NETCDF_C_HOME}/lib64:\
${NETCDF_F_HOME}/lib64${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"


# ============================================================================
# Link-time library search path
# ============================================================================

export LIBRARY_PATH="\
${GCC_ROOT}/lib64:\
${GCC_ROOT}/lib:\
${FLIBROOT}:\
${OPENMPI_HOME}/lib:\
${HDF5_HOME}/lib64:\
${NETCDF_C_HOME}/lib64:\
${NETCDF_F_HOME}/lib64${LIBRARY_PATH:+:${LIBRARY_PATH}}"


# ============================================================================
# Include search path
#
# OpenMPI headers are retained for compatibility with TRANSP.
# ============================================================================

export CPATH="\
/usr/include/openmpi-x86_64:\
/usr/include${CPATH:+:${CPATH}}"


# ============================================================================
# Environment summary
# ============================================================================

echo
echo "============================================================"
echo " EZCDF environment -- Ranger / GCC ${GCC_VERSION}"
echo "============================================================"
echo

echo "Compilers:"
echo "  FC                = ${FC}"
echo "  CC                = ${CC}"
echo "  CXX               = ${CXX}"
echo "  GCC_VERSION       = ${GCC_VERSION}"
echo "  MPIF90            = ${MPIF90}"
echo "  MPICC             = ${MPICC}"
echo "  MPICXX            = ${MPICXX}"
echo

echo "Build:"
echo "  MAKE_SO           = ${MAKE_SO}"
echo "  PREFIX            = ${PREFIX}"
echo

echo "GCC runtime:"
echo "  GCC_ROOT          = ${GCC_ROOT}"
echo "  GCC_RUNTIME_ROOT  = ${GCC_RUNTIME_ROOT}"
echo "  FLIBROOT          = ${FLIBROOT}"
echo

echo "OpenMPI:"
echo "  OPENMPI_HOME      = ${OPENMPI_HOME}"
echo

echo "NetCDF:"
echo "  NETCDF_F_HOME     = ${NETCDF_F_HOME}"
echo "  NETCDF_C_HOME     = ${NETCDF_C_HOME}"
echo "  NETCDF_MODDIR     = ${NETCDF_MODDIR}"
echo

echo "HDF5:"
echo "  HDF5_HOME         = ${HDF5_HOME}"
echo

echo "Compiler flags:"
echo "  FFLAGS            = ${FFLAGS}"
echo "  CFLAGS            = ${CFLAGS}"
echo "  CXXFLAGS          = ${CXXFLAGS}"
echo "  LDFLAGS           = ${LDFLAGS}"
echo

echo "Libraries:"
echo "  L_NETCDF          = ${L_NETCDF}"
echo "  L_HDF5            = ${L_HDF5}"
echo "  L_FLIBS           = ${L_FLIBS}"
echo "  L_CLIBS           = ${L_CLIBS}"
echo

echo "Runtime paths:"
echo "  LD_LIBRARY_PATH   = ${LD_LIBRARY_PATH}"
echo "  LIBRARY_PATH      = ${LIBRARY_PATH}"
echo "  CPATH             = ${CPATH}"
echo

echo "============================================================"
